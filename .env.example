# Supabase project settings (Project Settings > API).
# The publishable key is designed for browsers and is safe to expose, because
# Row Level Security (supabase/migrations) controls what it can do.
# NEVER put a secret key or the service_role key in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
